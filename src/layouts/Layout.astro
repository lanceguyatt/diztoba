---
import { Font } from 'astro:assets'
import { SEO } from 'astro-seo'
import '@/styles/main.css'
import Analytics from '@/components/Analytics.astro'
import { site } from '@/constants'

type Props = {
  class?: string
}

const { class: className } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-axiforma" preload />
    <Font cssVariable="--font-gotham" preload />
    <Font cssVariable="--font-realbook" />
    <SEO
      title={site.name}
      description={site.description}
      openGraph={{
        basic: {
          title: site.name,
          type: 'A type.',
          image: site.image.secure_url,
          url: site.url,
        },
      }}
      twitter={{
        creator: '@dtoba',
      }}
      extend={{
        link: [
          { rel: 'icon', type: 'image/png', href: '/favicon.png' },
          { rel: 'author', type: 'text/plain', href: '/humans.txt' },
        ],
        meta: [
          {
            name: 'twitter:image',
            content: site.image.secure_url,
          },
          { name: 'twitter:title', content: site.name },
          { name: 'twitter:description', content: site.description },
        ],
      }}
    />
    <Analytics />
  </head>
  <body class:list={['bg-scene text-foreground min-h-dvh font-sans antialiased', className]}>
    <main class="mx-auto max-w-xl px-6 py-12 text-center">
      <slot />
    </main>

    <footer class="text-foreground-muted px-6 pt-8 pb-12 text-center text-sm">
      © 2026 {site.name}
    </footer>
  </body>
</html>
