---
import { type HTMLAttributes } from 'astro/types'
import '@/styles/main.css'
import { Font } from 'astro:assets'
import { SEO, type Props as SEOProps } from 'astro-seo'
import Analytics from '@/components/Analytics.astro'
import { site, dizToba } from '@/constants'

type Props = HTMLAttributes<'body'> & SEOProps

const { title, description = site.description, noindex, nofollow, class: className } = Astro.props

const pageTitle = title ? `${title} | ${site.name}` : site.title
const pageUrl = new URL(Astro.url.pathname, Astro.site).href

const webPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description,
  url: pageUrl,
  image: site.image.secure_url,
  inLanguage: 'en-GB',
  isPartOf: {
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
  },
  about: {
    '@type': 'Person',
    '@id': `${dizToba.url}/#person`,
    name: dizToba.name,
    description: dizToba.description,
    jobTitle: dizToba.jobTitle,
    homeLocation: { '@type': 'Place', name: dizToba.homeLocation },
    url: dizToba.url,
    image: dizToba.image.secure_url,
    sameAs: dizToba.socials.map((social) => social.url),
  },
}
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-axiforma" preload />
    <Font cssVariable="--font-gotham" preload />
    <Font cssVariable="--font-realbook" />
    <SEO
      title={pageTitle}
      {description}
      openGraph={{
        basic: {
          title: pageTitle,
          type: 'website',
          image: site.image.secure_url,
          url: pageUrl,
        },
        optional: {
          description,
          siteName: site.name,
          locale: site.locale,
        },
        image: {
          secureUrl: site.image.secure_url,
          type: site.image.type,
          width: site.image.width,
          height: site.image.height,
          alt: site.image.alt,
        },
      }}
      twitter={{
        card: 'summary',
        creator: site.twitter,
        title: pageTitle,
        description,
        image: site.image.secure_url,
        imageAlt: site.image.alt,
      }}
      extend={{
        link: [
          { rel: 'icon', type: 'image/png', href: '/favicon.png' },
          { rel: 'author', type: 'text/plain', href: '/humans.txt' },
        ],
      }}
      noindex={!!noindex}
      nofollow={!!nofollow}
    />
    <script type="application/ld+json" set:html={JSON.stringify(webPage)} />
    <Analytics />
  </head>
  <body class:list={['bg-scene text-foreground min-h-dvh antialiased', className]}>
    <main class="mx-auto max-w-xl px-6 py-12 text-center">
      <slot />
    </main>

    <footer class="text-foreground-muted px-6 pt-8 pb-12 text-center text-sm">
      © 2026 {site.name}
    </footer>
  </body>
</html>
