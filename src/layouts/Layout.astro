---
import { Font } from 'astro:assets'
import { SEO } from 'astro-seo'
import '@/styles/main.css'
import Analytics from '@/components/Analytics.astro'
import { site } from '@/constants'

type Props = {
  class?: string
}

const { class: className } = Astro.props

const webPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: site.name,
  description: site.description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  image: site.image.secure_url,
  inLanguage: 'en',
  about: {
    '@type': 'Person',
    name: site.name,
    url: Astro.site?.href,
    image: site.image.secure_url,
    sameAs: site.socials.map((social) => social.url),
  },
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-axiforma" preload />
    <Font cssVariable="--font-gotham" preload />
    <Font cssVariable="--font-realbook" />
    <SEO
      title={site.name}
      description={site.description}
      openGraph={{
        basic: {
          title: site.name,
          type: 'A type.',
          image: site.image.secure_url,
          url: site.url,
        },
      }}
      twitter={{
        creator: '@dtoba',
      }}
      extend={{
        link: [
          { rel: 'icon', type: 'image/png', href: '/favicon.png' },
          { rel: 'author', type: 'text/plain', href: '/humans.txt' },
        ],
        meta: [
          {
            name: 'twitter:image',
            content: site.image.secure_url,
          },
          { name: 'twitter:title', content: site.name },
          { name: 'twitter:description', content: site.description },
        ],
      }}
    />
    <script type="application/ld+json" set:html={JSON.stringify(webPage)} />
    <Analytics />
  </head>
  <body class:list={['bg-scene text-foreground min-h-dvh antialiased', className]}>
    <main class="mx-auto max-w-xl px-6 py-12 text-center">
      <slot />
    </main>

    <footer class="text-foreground-muted px-6 pt-8 pb-12 text-center text-sm">
      © 2026 {site.name}
    </footer>
  </body>
</html>
