---
import { Button, Card, Heading } from '@/components'
---

<Card
  as="section"
  x-load="eager"
  x-data="signupForm"
  class="mt-12"
  aria-labelledby="signup-title"
  id="signup"
>
  <Heading id="signup-title">Join the mailing list</Heading>
  <p class="text-ink-muted mt-2">New music, shows and the odd bit of news. No spam.</p>

  <form
    name="signUp"
    method="post"
    class="mt-6 grid gap-4"
    data-netlify="true"
    netlify-honeypot="bot-field"
  >
    <p
      class="bg-danger-surface text-danger rounded-md px-4 py-3 text-sm"
      role="alert"
      data-show="error"
      hidden=""
    >
      Please check the highlighted field and try again.
    </p>

    <p hidden="">
      <label>
        Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <div class="grid gap-1">
      <label for="firstName" class="text-sm font-semibold">
        First name
      </label>
      <input
        id="firstName"
        name="firstName"
        autocomplete="given-name"
        value=""
        class="border-input-border bg-input placeholder:text-input-placeholder w-full rounded-md border px-4 py-3"
        required
      />
    </div>

    <p hidden>
      <label>
        Ignore: <input name="bot-field" />
      </label>
    </p>

    <input type="hidden" name="form-name" value="signUp" />

    <div class="grid gap-1">
      <label for="email" class="text-sm font-semibold">
        Email address
      </label>
      <input
        aria-describedby="email-error"
        aria-invalid="false"
        aria-label="Email address"
        class="border-input-border bg-input placeholder:text-input-placeholder aria-invalid:border-danger w-full rounded-md border px-4 py-3 aria-invalid:border-2"
        id="email"
        name="email"
        placeholder="Email address"
        required
        type="email"
        value=""
        x-model="formData.email"
        x-ref="email"
      />
      <p class="text-danger text-sm" id="email-error" data-show="error" hidden="">
        Enter an email address like name@example.com
      </p>
    </div>

    <p class="text-ink-muted text-sm">
      By signing up you agree to receive emails from Diz Toba. Unsubscribe at any time.
    </p>

    <div>
      <Button type="submit" id="submit">
        Sign up
      </Button>
    </div>
  </form>

  <div
    class="bg-success-surface text-success mt-6 rounded-md p-6"
    role="status"
    data-show="success"
    hidden=""
  >
    <h3 class="font-display text-xl font-bold">You're on the list</h3>
    <p class="text-ink mt-2">Thanks, Amara. Look out for the next email from Diz Toba.</p>
  </div>
</Card>
