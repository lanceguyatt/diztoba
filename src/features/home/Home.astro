---
import { site } from '@/constants'
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'

import cover from '@/images/venom-and-lemonade.jpg'

const socials = await getCollection('nav')
socials.sort((a, b) => a.data.order - b.data.order)
---


<div class="grid gap-6 place-items-center">
  <Image src={cover} width="600" height="600" alt="Cover of Venom & Lemonade" />
  <nav>
    <ul class="mx-auto flex gap-4 flex-wrap">
      {
        socials.map(({ data }) => {
          const { name, url } = data
          return (
            <li>
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                title={name}
              >
                {name}
              </a>
            </li>
          )
        })
      }
    </ul>
  </nav>
</div>
