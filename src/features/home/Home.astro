---
import cover from '@/images/venom-and-lemonade.jpg'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { site } from '@/constants'
---

<article class="text-center">
  <div class="container">
    <Image src={cover} width={600} height={600} alt="Cover of Venom & Lemonade" class="mx-auto" />

    <nav class="mt-6">
      <ul class="flex flex-wrap justify-center gap-4">
        {site.socials.map((social) => {
          return (
            <li>
              <a href={social.url} target="_blank" rel="noopener noreferrer" title={social.name}>
                <span class="sr-only">{social.name}</span>
                <Icon name={social.icon} size={48} />
              </a>
            </li>
          )
        })}
      </ul>
    </nav>
  </div>
</article>
