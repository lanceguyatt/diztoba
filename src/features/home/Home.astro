---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { SignupForm } from '@/components/signupForm'
import SoundCloud from '@/components/SoundCloud.astro'
import { site } from '@/constants'
import cover from '@/images/venom-and-lemonade.jpg'
---

<article class="text-center">
  <div class="container">
    <Image
      src={cover}
      width={600}
      height={600}
      alt="Cover of Venom & Lemonade"
      densities={[1.5, 2]}
      class="mx-auto mb-8 rounded-xl"
      priority
    />

    <nav class="mt-6">
      <ul class="flex flex-wrap justify-center gap-4">
        {site.socials.map((social) => {
          return (
            <li>
              <a href={social.url} target="_blank" rel="noopener noreferrer" title={social.name}>
                <span class="sr-only">{social.name}</span>
                <Icon name={social.icon} size={24} />
              </a>
            </li>
          )
        })}
      </ul>
    </nav>

    <SignupForm />

    <SoundCloud />
  </div>
</article>
